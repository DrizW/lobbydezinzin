// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  role           String   @default("USER")
  allowedIPs     String?  // IPs autorisées pour le Smart DNS (séparées par virgules)
  subscriptions  Subscription[]
  settings       UserSettings?
  dnsLogs        DNSLog[] // Logs d'activité DNS
  // NextAuth fields
  name           String?
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]

  // 2FA (TOTP)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?

  auditLogs      AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  adminNotes              AdminNote[]
  backupCodes             TwoFactorBackupCode[]
  userSessions            UserSession[]
  cookieConsents          CookieConsent[]
  analyticsEvents         AnalyticsEvent[]
  notifications           UserNotification[]
}

model UserSettings {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String   @unique
  selectedCountry   String   @default("nigeria") // Pays sélectionné par l'utilisateur
  autoRotate        Boolean  @default(false)     // Rotation automatique par heure
  lastUpdated       DateTime @default(now()) @updatedAt
  createdAt         DateTime @default(now())
}

model Subscription {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  stripeId     String   @unique
  status       String   // "active", "canceled", "expired", etc.
  currentPeriodEnd DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Country {
  id            String   @id @default(cuid())
  name          String   @unique
  flag          String
  kdRange       String
  kdValue       Float
  description   String
  dnsPrimary    String
  dnsSecondary  String
  color         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// NextAuth models (copié de la doc officielle)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires   DateTime

  @@unique([identifier, token])
}

/// Email verification token for custom flows (credentials provider)
model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

/// Password reset token for credential users
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

/// Audit logs for security-sensitive operations
model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
}

/// Codes de secours 2FA (hashés)
model TwoFactorBackupCode {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId, used])
}

/// Sessions actives des utilisateurs avec informations détaillées
model UserSession {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  sessionToken String   @unique
  deviceName   String?  // Nom de l'appareil (ex: "iPhone 15", "Chrome sur Windows")
  deviceType   String?  // Type d'appareil (mobile, desktop, tablet)
  browser      String?  // Navigateur (Chrome, Firefox, Safari, etc.)
  os           String?  // Système d'exploitation (Windows, macOS, iOS, Android)
  ip           String?  // Adresse IP
  location     String?  // Localisation approximative
  isCurrent    Boolean  @default(false) // Session actuelle
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  
  @@index([userId, isCurrent])
  @@index([userId, lastActivity])
}

model DNSLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  domain    String   // Domaine demandé (ex: prod.demonware.net)
  region    String   // Région sélectionnée (ex: taiwan)
  clientIP  String   // IP publique du client
  timestamp DateTime @default(now())
  
  @@index([userId, timestamp])
  @@index([domain])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  priority  String   @default("normal") // "low", "normal", "high", "urgent"
  status    String   @default("pending") // "pending", "in_progress", "resolved", "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Notes internes pour le support/admin
model AdminNote {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  authorId  String?
  text      String
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
}

/// Préférences cookies et consentement RGPD
model CookieConsent {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  sessionId String?  // Pour les utilisateurs non connectés
  essential Boolean  @default(true)  // Cookies essentiels (toujours acceptés)
  analytics Boolean  @default(false) // Cookies d'analyse
  marketing Boolean  @default(false) // Cookies marketing
  performance Boolean @default(false) // Cookies de performance
  preferences Boolean @default(false) // Cookies de préférences
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

/// Journal des événements analytics
model AnalyticsEvent {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  sessionId String?  // Pour les utilisateurs non connectés
  event     String   // register, subscribe, churn, region_change, etc.
  category  String   // user, subscription, region, etc.
  action    String   // created, updated, deleted, etc.
  label     String?  // Détails supplémentaires
  value     Float?   // Valeur numérique si applicable
  properties Json?   // Propriétés supplémentaires
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([userId, event, createdAt])
  @@index([event, createdAt])
  @@index([category, action])
}

/// Notifications utilisateur
model UserNotification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // info, success, warning, error
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?  // URL d'action optionnelle
  actionLabel String? // Label du bouton d'action
  createdAt DateTime @default(now())
  
  @@index([userId, read])
  @@index([userId, createdAt])
}
